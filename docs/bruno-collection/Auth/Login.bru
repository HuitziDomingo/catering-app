meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{loginEmail}}",
    "password": "{{loginPassword}}"
  }
}

script:post-response {
  // Guarda el par de tokens para el resto de la colección (auth: inherit en
  // collection.bru). Variable runtime, no de entorno: no escribe tokens en
  // environments/Local.bru, que está versionado.
  if (res.status === 200 && res.body && res.body.accessToken) {
    bru.setVar("token", res.body.accessToken);
    bru.setVar("refreshToken", res.body.refreshToken);
  }
}

tests {
  test("login 200 y devuelve accessToken", function () {
    expect(res.status).to.equal(200);
    expect(res.body.accessToken).to.be.a("string");
  });
}

docs {
  Autentica un usuario existente. Guarda `token`/`refreshToken` como
  variables runtime -- todas las demás requests de la colección heredan
  este `token` automáticamente (auth: inherit → Bearer, ver
  collection.bru).

  Email y contraseña salen de las variables `loginEmail`/`loginPassword`
  del environment (vienen con la cuenta de ejemplo de **Auth > Register**).
  Para los endpoints de staff (Menu > escritura, Orders > gestión) cambialas
  a una cuenta staff/admin/superadmin **solo en tu copia local**: no
  commitees contraseñas reales en `environments/Local.bru`.

  Límite: 5 requests/min por IP.
}
