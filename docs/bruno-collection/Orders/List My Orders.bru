meta {
  name: List My Orders
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/orders/mine
  body: none
  auth: inherit
}

params:query {
  ~status: pending,confirmed
  ~page: 1
  ~pageSize: 20
}

tests {
  test("200 paginado", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body).to.have.property("total");
  });
}

docs {
  "Mis pedidos" (ADR-027): los pedidos del usuario logueado, más recientes
  primero. Cualquier rol autenticado; el cliente sale del JWT, nunca de la
  query.

  Filtros opcionales (deshabilitados por default, prefijo `~`):
  - `status`: uno o varios, separados por coma (pending, confirmed,
    preparing, delivered, cancelled, payment_failed).
  - `page` (desde 1) y `pageSize` (máx. 100, default 20).

  Respuesta `Paginated<Order>`: `items`, `total`, `page`, `pageSize`.
}
