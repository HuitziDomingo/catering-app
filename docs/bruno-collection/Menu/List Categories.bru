meta {
  name: List Categories
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/menu/categories
  body: none
  auth: none
}

script:post-response {
  // Primera categoría como default para Menu > Create Item, sin pisar una
  // que ya hayas elegido a mano.
  if (!bru.getVar("categoryId") && !bru.getEnvVar("categoryId") && Array.isArray(res.body) && res.body.length) {
    bru.setVar("categoryId", res.body[0].id);
  }
}

docs {
  Público -- no requiere JWT. Devuelve categorías activas ordenadas por
  `displayOrder`.

  No hay endpoint para crear categorías (se siembran por migración/seed,
  ver ADR-006). Si `categoryId` está vacía, el script guarda la primera
  categoría de la respuesta como variable runtime para Menu > Create Item.
}
