meta {
  name: List Items
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/menu/items
  body: none
  auth: none
}

params:query {
  ~categoryId: {{categoryId}}
}

script:post-response {
  // Primer platillo como default para los requests que usan menuItemId,
  // sin pisar uno que ya hayas elegido a mano.
  if (!bru.getVar("menuItemId") && !bru.getEnvVar("menuItemId") && Array.isArray(res.body) && res.body.length) {
    bru.setVar("menuItemId", res.body[0].id);
  }
}

docs {
  Público -- no requiere JWT. `categoryId` es un filtro opcional, viene
  deshabilitado por default (prefijo `~`) -- habilitalo en el panel de
  params de Bruno para filtrar por categoría.

  Cada platillo trae `imageUrl` (URL pública armada por la API a partir de
  `menu_items.image_key`, ADR-028) o `null`, y `basePrice` como número.

  Si `menuItemId` está vacía, el script guarda el primer platillo como
  variable runtime para Update/Delete/imagen, Orders y MCP.
}
