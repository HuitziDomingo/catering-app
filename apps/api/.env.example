# --- Base de datos (Supabase / Postgres) — ADR-001, ADR-010 ---
# Cadena de conexión completa. NUNCA se hardcodea en el código ni se commitea.
# Supabase la entrega en: Project Settings > Database > Connection string (URI).
DATABASE_URL=postgres://user:password@host:5432/postgres

# Supabase exige SSL. En Postgres local de desarrollo, dejar en false.
DATABASE_SSL=true

# Logs de SQL de TypeORM (ruidoso). Útil solo al depurar.
DATABASE_LOGGING=false

# --- Auth / JWT propios (ADR-010) ---
# Secretos independientes para access y refresh. Generar valores largos y
# aleatorios (p. ej. `openssl rand -hex 32`). NO reutilizar el mismo para ambos.
JWT_ACCESS_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo-y-aleatorio
JWT_REFRESH_EXPIRES_IN=7d

# --- Mercado Pago / Checkout Pro (ADR-022, ADR-024) ---
# Access Token de la cuenta de Mercado Pago. Developers > Tus integraciones >
# tu aplicación > Credenciales. Ojo: el prefijo no basta para saber si es de
# prueba. Las credenciales de prueba pueden ser TEST-..., pero las de un
# USUARIO DE PRUEBA también empiezan con APP_USR-, igual que las de producción.
# Verifica con GET https://api.mercadopago.com/users/me (Authorization: Bearer
# <token>) que la cuenta tenga el tag "test_user" antes de usarlo en desarrollo.
MERCADOPAGO_ACCESS_TOKEN=TEST-cambiar-por-tu-access-token-de-prueba 

# Secreto usado para validar la firma (x-signature) del webhook de pagos. Se
# genera al configurar la URL de notificaciones en Developers > Tus
# integraciones > tu aplicación > Webhooks > Configurar notificaciones.
MERCADOPAGO_WEBHOOK_SECRET=cambiar-por-el-secreto-de-tu-webhook

# Public Key de prueba. La API no la usa: solo la necesita el modo APRO/OTHE
# del smoke test (apps/api/scripts/mp-smoke.ts) para tokenizar tarjetas.
MERCADOPAGO_PUBLIC_KEY=TEST-cambiar-por-tu-public-key-de-prueba

# Email de un usuario de prueba COMPRADOR (mismo país que el vendedor). Solo lo
# usa el modo APRO/OTHE del smoke test como payer de POST /v1/payments.
# SMOKE_PAYER_EMAIL=


# --- Servidor ---
PORT=3000

# --- WhatsApp vía Twilio (ADR-026) ---
# Credenciales del sandbox de WhatsApp de Twilio (Account SID + Auth Token,
# Console > Account Info). Nunca usar credenciales de producción en desarrollo.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=cambiar-por-el-auth-token-del-sandbox
# Número del sandbox de WhatsApp de Twilio, con el prefijo whatsapp: incluido.
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Número de WhatsApp del negocio (mismo formato con prefijo whatsapp:) donde
# llegan los avisos de pedido nuevo.
BUSINESS_WHATSAPP_NUMBER=whatsapp:+5215500000000
