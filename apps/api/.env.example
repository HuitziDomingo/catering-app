# --- Base de datos (Supabase / Postgres) — ADR-001, ADR-010 ---
# Cadena de conexión completa. NUNCA se hardcodea en el código ni se commitea.
# Supabase la entrega en: Project Settings > Database > Connection string (URI).
DATABASE_URL=postgres://user:password@host:5432/postgres

# Supabase exige SSL. En Postgres local de desarrollo, dejar en false.
DATABASE_SSL=true

# Logs de SQL de TypeORM (ruidoso). Útil solo al depurar.
DATABASE_LOGGING=false

# --- Auth / JWT propios (ADR-010) ---
# Secretos independientes para access y refresh. Generar valores largos y
# aleatorios (p. ej. `openssl rand -hex 32`). NO reutilizar el mismo para ambos.
JWT_ACCESS_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo-y-aleatorio
JWT_REFRESH_EXPIRES_IN=7d

# --- Mercado Pago / Checkout Pro (ADR-022, ADR-024) ---
# Access Token de la cuenta de Mercado Pago. Developers > Tus integraciones >
# tu aplicación > Credenciales. Ojo: el prefijo no basta para saber si es de
# prueba. Las credenciales de prueba pueden ser TEST-..., pero las de un
# USUARIO DE PRUEBA también empiezan con APP_USR-, igual que las de producción.
# Verifica con GET https://api.mercadopago.com/users/me (Authorization: Bearer
# <token>) que la cuenta tenga el tag "test_user" antes de usarlo en desarrollo.
MERCADOPAGO_ACCESS_TOKEN=TEST-cambiar-por-tu-access-token-de-prueba 

# Secreto usado para validar la firma (x-signature) del webhook de pagos. Se
# genera al configurar la URL de notificaciones en Developers > Tus
# integraciones > tu aplicación > Webhooks > Configurar notificaciones.
MERCADOPAGO_WEBHOOK_SECRET=cambiar-por-el-secreto-de-tu-webhook

# Public Key de prueba. La API no la usa: solo la necesita el modo APRO/OTHE
# del smoke test (apps/api/scripts/mp-smoke.ts) para tokenizar tarjetas.
MERCADOPAGO_PUBLIC_KEY=TEST-cambiar-por-tu-public-key-de-prueba

# Email de un usuario de prueba COMPRADOR (mismo país que el vendedor). Solo lo
# usa el modo APRO/OTHE del smoke test como payer de POST /v1/payments.
# SMOKE_PAYER_EMAIL=

# URL pública HTTPS de esta API, SIN el sufijo /api (ej. el túnel de ngrok o
# cloudflared que ya usas para el webhook: https://abc123.ngrok-free.app).
# Con ella se arman las back_urls de Checkout Pro (GET /api/payments/return/
# :result), que redirigen al deep link de la app. Mercado Pago exige HTTPS
# público para auto_return: si se deja vacía, la preferencia se crea sin
# back_urls y el cliente regresa a la app a mano. Ver addendum 01 de ADR-024.
# API_PUBLIC_URL=

# Deep link base al que redirige /payments/return/:result (se le agrega
# /success|/failure|/pending). Default: mobile://payment (scheme de
# apps/mobile/app.json). Para Expo web: http://localhost:8081/payment.
# MOBILE_PAYMENT_RETURN_URL=mobile://payment


# --- Servidor ---
PORT=3000

# --- Almacenamiento de archivos (ADR-028) ---
# Imágenes del menú (bucket de lectura pública) y recibos PDF (bucket privado,
# URLs firmadas). En local: SeaweedFS de docker-compose.yml (`docker compose up
# -d`); estos valores son los de desarrollo y no son secretos. En producción:
# endpoint S3 de Supabase Storage y sus access keys (Project Settings > Storage
# > S3 Connection), solo como variables de Cloud Run.
#
# Endpoint que usa la API para subir y borrar. La API corre en tu Mac, así que
# en desarrollo siempre es localhost.
STORAGE_ENDPOINT=http://localhost:8333
# Base de las URLs que reciben los clientes (dashboard y app). Independiente de
# STORAGE_ENDPOINT: un teléfono no ve el localhost de tu Mac.
#   Navegador de la Mac / simulador iOS: http://localhost:8333
#   Emulador Android: http://localhost:8333 + `adb reverse tcp:8333 tcp:8333`
#   Teléfono físico por Wi-Fi: http://<IP de tu Mac>:8333 (ej. http://192.168.1.68:8333)
# La base guarda llaves, no URLs: si cambia, solo reinicia la API.
# Producción: https://<ref>.supabase.co/storage/v1/object/public
STORAGE_PUBLIC_URL=http://localhost:8333
# Host con el que se firman las URLs de recibos. Vacío = STORAGE_PUBLIC_URL
# (correcto en local). Producción: https://<ref>.supabase.co/storage/v1/s3
# STORAGE_SIGNED_URL_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=catering_dev
STORAGE_SECRET_ACCESS_KEY=catering_dev_storage_secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_MENU_IMAGES_BUCKET=menu-images
STORAGE_DOCUMENTS_BUCKET=order-documents

# --- WhatsApp vía Meta Cloud API (ADR-029) ---
# Sin WHATSAPP_PHONE_NUMBER_ID o WHATSAPP_ACCESS_TOKEN la API arranca igual
# y solo registra que WhatsApp está deshabilitado (los pedidos no fallan).
# Los valores salen de developers.facebook.com > tu app > WhatsApp >
# Configuración de la API. NUNCA pongas un token real en este archivo.
#
# id del número emisor (no es el número de teléfono).
WHATSAPP_PHONE_NUMBER_ID=
# Token con permiso whatsapp_business_messaging. El de "Configuración de la
# API" caduca en 24 h; en producción usa el de un usuario de sistema.
WHATSAPP_ACCESS_TOKEN=
# Versión de la Graph API (default v25.0).
WHATSAPP_API_VERSION=v25.0
# id de la cuenta de WhatsApp Business (WABA). Solo para consultar
# plantillas (GET /{id}/message_templates); la API no lo usa para enviar.
# WHATSAPP_BUSINESS_ACCOUNT_ID=
#
# test: todos los avisos mandan una plantilla de ejemplo de Meta (ya
# aprobada), mientras Meta aprueba las propias. production: las plantillas
# de docs/whatsapp-plantillas.md (es_MX). Default: test.
WHATSAPP_TEMPLATE_MODE=test
# Plantilla del modo test: jaspers_market_order_confirmation_v1 (default,
# lleva nombre, folio y fecha) o hello_world (sin variables).
# WHATSAPP_TEST_TEMPLATE=jaspers_market_order_confirmation_v1
# Formato de los celulares de México: 52 (52 + 10 dígitos, default) o 521.
# Ver "El detalle del 52 1" en ADR-029.
# WHATSAPP_MX_NUMBER_FORMAT=52
#
# Solo desarrollo: tu número, tal como aparece en la lista de destinatarios
# permitidos del número de prueba de Meta. Lo usa `pnpm run wa:smoke`.
# En modo prueba Meta solo entrega a números de esa lista, incluido
# BUSINESS_WHATSAPP_NUMBER.
WHATSAPP_TEST_RECIPIENT=
#
# Número del negocio que recibe el aviso de pedido nuevo. 10 dígitos de
# México o 52 + 10 dígitos (también acepta +52 1, espacios y guiones).
BUSINESS_WHATSAPP_NUMBER=5500000000

# --- Link al recibo en WhatsApp (ADR-029) ---
# Firma el link de 30 días del botón "Ver recibo" (GET /api/receipts/:token).
# Mínimo 32 caracteres, distinto de los JWT_*. Genera uno con:
#   openssl rand -base64 48
# Sin ella los avisos no llevan link; con WHATSAPP_TEMPLATE_MODE=production es
# obligatoria. Cambiarla invalida todos los links ya enviados.
RECEIPT_LINK_SECRET=

# --- Datos del negocio en el recibo PDF (ADR-028) ---
# Encabezado del recibo. Van por entorno para cambiarlos sin recompilar; solo
# afectan los recibos que se generen después (los ya generados no cambian).
# Si BUSINESS_NAME falta se usa "Santo Sazón"; los demás son opcionales y, si
# están vacíos, el recibo omite esa línea.
BUSINESS_NAME=Santo Sazón
BUSINESS_ADDRESS=Calle Ejemplo 123, Col. Centro, Ciudad de México
BUSINESS_PHONE=55 0000 0000
BUSINESS_EMAIL=
# RFC del negocio. El recibo no es un CFDI aunque lo muestre.
BUSINESS_RFC=
# Zona horaria de las fechas del recibo (default America/Mexico_City).
# BUSINESS_TIMEZONE=America/Mexico_City
