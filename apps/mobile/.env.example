# Expo inlines vars prefixed EXPO_PUBLIC_ into the JS bundle at build time.
# Default (used when unset) points at `nx serve api` running locally against
# the Dockerized Postgres (ADR-014). When unset, the default is per-platform:
# localhost on iOS/web, 10.0.2.2 (the host alias) on the Android emulator --
# see src/core/http/defaultApiUrl.ts. If you set it, Android needs 10.0.2.2
# (or `adb reverse tcp:3000 tcp:3000` to keep localhost).
EXPO_PUBLIC_API_URL=http://localhost:3000/api
