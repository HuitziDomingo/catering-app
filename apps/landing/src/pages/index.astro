---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import { business } from '../data/site';
---

<BaseLayout
  title={`${business.name} · ${business.tagline}`}
  description="Catering mexicano para eventos sociales, corporativos y bodas. Pide desde la app, paga con Mercado Pago y recibe tu confirmación por WhatsApp."
>
  <Header />
  <main id="contenido">
    <Hero />
  </main>
</BaseLayout>
