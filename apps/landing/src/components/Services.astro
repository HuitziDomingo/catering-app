---
import { photoSrcset, photoUrl, services } from '../data/site';
---

<section class="section services" id="servicios" aria-labelledby="servicios-title">
  <div class="wrap">
    <header class="section-head reveal">
      <p class="eyebrow">Servicios</p>
      <h2 id="servicios-title">Una mesa para cada ocasión</h2>
      <p>Del desayuno de la oficina a la boda de tu hermana: adaptamos el menú, las porciones y el montaje.</p>
    </header>

    <ul class="cards">
      {services.map((service, index) => (
        <li class="card reveal">
          <figure>
            <img
              src={photoUrl(service.photo, 640, 800)}
              srcset={photoSrcset(service.photo, [400, 640, 900], 1.25)}
              sizes="(min-width: 1100px) 18rem, (min-width: 640px) 45vw, 92vw"
              width="640"
              height="800"
              alt={service.photo.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="card-body">
            <span class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cards {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    margin: 0;
    list-style: none;
    background: var(--ss-blanco);
    border-radius: var(--ss-radius);
    overflow: hidden;
    box-shadow: var(--ss-shadow);
  }
  figure {
    margin: 0;
    aspect-ratio: 4 / 4.2;
    overflow: hidden;
  }
  figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ss-ease);
  }
  .card:hover figure img {
    transform: scale(1.05);
  }
  .card-body {
    position: relative;
    padding: 1.5rem 1.5rem 1.75rem;
  }
  .card-number {
    display: block;
    margin-bottom: 0.4rem;
    font-family: var(--ss-font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--ss-terracota-ink);
  }
  h3 {
    margin-bottom: 0.6rem;
    font-size: 1.55rem;
  }
  .card-body p {
    margin: 0;
    color: var(--ss-texto-suave);
  }

  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }
  @media (min-width: 1100px) {
    .cards {
      grid-template-columns: repeat(4, 1fr);
    }
    /* Ritmo escalonado en escritorio. */
    .card:nth-child(even) {
      transform: translateY(2.5rem);
    }
    .services {
      padding-bottom: calc(var(--ss-section-y) + 2.5rem);
    }
  }
</style>
